# Copiez ce fichier en .env (ou définissez ces variables chez votre hébergeur)

# Port HTTP du serveur
PORT=8080

# Secret de signature des sessions (64 caractères aléatoires recommandés)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LAGO_SECRET=

# false en production : masque les comptes démo et ne crée pas Sarah/Léa/admin@lago.app
DEMO_MODE=true

# Super Admin créé/mis à jour au démarrage (mot de passe ≥ 8 caractères)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# Origines supplémentaires autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=

# Pour construire l'app mobile connectée au serveur :
# LAGO_API_URL=https://api.votre-domaine.com npm run build:mobile

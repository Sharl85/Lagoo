{
  "name": "lago-app",
  "version": "3.0.0",
  "private": true,
  "description": "LaGo - Application web & mobile de calcul et suivi du cycle menstruel",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node scripts/build.js && node server/server.js",
    "build": "node scripts/build.js",
    "build:web": "node scripts/build.js web",
    "build:mobile": "node scripts/build.js mobile",
    "test": "node --test tests/*.test.js",
    "cap:sync": "node scripts/build.js mobile && npx cap sync android",
    "android": "node scripts/build.js mobile && npx cap sync android && npx cap open android",
    "android:apk": "node scripts/build.js mobile && npx cap sync android && cd android && ./gradlew assembleDebug",
    "serve:static": "npx serve dist/web -l 8080",
    "start:env": "node --env-file=.env server/server.js",
    "android:icons": "npx @capacitor/assets generate --android --iconBackgroundColor \"#fce4ec\" --splashBackgroundColor \"#fff5f7\""
  },
  "engines": {
    "node": ">=20"
  },
  "author": "LaGo Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "lucide": "^1.49.0"
  }
}
